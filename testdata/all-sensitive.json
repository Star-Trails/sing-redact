{
  // sing-box testing 1.14-style configuration with intentional secrets.
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-private",
        "server": "resolver.private.example",
        "server_port": 443,
        "path": "/dns-query",
        "headers": {
          "Authorization": "Bearer DNS_HEADER_SECRET",
          "User-Agent": "sing-box-redact-test",
          "Host": "resolver.private.example",
        },
      },
      {
        "type": "hosts",
        "tag": "hosts-local",
        "path": "C:\\Users\\Alice\\hosts.txt",
        "predefined": {
          "nas.home": "192.168.1.2",
          "printer.home": ["192.168.1.3"],
        },
      },
    ],
    "rules": [
      {
        "domain": ["internal.corp.example", "private.example.com"],
        "process_name": ["private-browser.exe"],
        "package_name": ["com.corp.private"],
        "wifi_ssid": ["Alice Home WiFi"],
        "wifi_bssid": ["aa:bb:cc:dd:ee:ff"],
        "source_mac_address": ["11:22:33:44:55:66"],
        "source_hostname": ["alice-laptop"],
        "action": "route",
        "server": "dns-private",
      },
    ],
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen_port": 8443,
      "users": [{"name": "Alice", "uuid": "bf000d23-0752-40b4-affe-68f7707a9661"}],
      "tls": {
        "enabled": true,
        "key": ["-----BEGIN PRIVATE KEY-----", "TLS_SERVER_PRIVATE_KEY", "-----END PRIVATE KEY-----"],
        "key_path": "C:\\Users\\Alice\\tls\\server.key",
        "certificate": ["TLS_SERVER_CERTIFICATE"],
        "certificate_path": "C:\\Users\\Alice\\tls\\server.crt",
        "reality": {
          "private_key": "REALITY_PRIVATE_KEY_SECRET",
          "public_key": "REALITY_PUBLIC_KEY",
          "short_id": ["12345678", "abcdef12"],
          "handshake": {"server": "reality-origin.secret.example", "server_port": 443},
        },
        "ech": {
          "enabled": true,
          "key": ["ECH_PRIVATE_KEY_SECRET"],
          "key_path": "C:\\Users\\Alice\\tls\\ech.key",
        },
      },
    },
    {
      "type": "shadowtls",
      "tag": "shadowtls-in",
      "password": "SHADOWTLS_IN_PASSWORD",
      "handshake_for_server_name": {
        "my-secret-domain.example": {"server": "origin.example", "server_port": 443},
        "another-secret-domain.example": {"server": "origin-two.example", "server_port": 8443},
      },
    },
    {
      "type": "cloudflared",
      "tag": "cloudflared-in",
      "token": "CLOUDFLARED_TUNNEL_TOKEN",
    },
    {
      "type": "ccm",
      "tag": "ccm-in",
      "credential_path": "C:\\Users\\Alice\\ccm-credential.json",
      "usages_path": "C:\\Users\\Alice\\ccm-usages.json",
      "users": [{"name": "ccm-alice", "token": "CCM_USER_TOKEN"}],
    },
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy-vless",
      "server": "node.secret.example",
      "server_port": 443,
      "uuid": "c15942d8-ba5e-49d3-b9b2-55be71a06b39",
      "flow": "xtls-rprx-vision",
      "tls": {"enabled": true, "server_name": "sni.secret.example", "reality": {"public_key": "REALITY_OUT_PUBLIC", "short_id": "deadbeef"}},
      "transport": {"type": "ws", "path": "/transport-path", "headers": {"X-API-Key": "WS_API_KEY_SECRET", "User-Agent": "Mozilla/5.0"}},
    },
    {"type": "vmess", "tag": "proxy-vmess", "server": "vmess.secret.example", "server_port": 443, "uuid": "20770855-8872-43b1-8695-2a9adf0f2a5b", "security": "auto"},
    {"type": "trojan", "tag": "proxy-trojan", "server": "trojan.secret.example", "server_port": 443, "password": "TROJAN_PASSWORD"},
    {"type": "tuic", "tag": "proxy-tuic", "server": "tuic.secret.example", "server_port": 443, "uuid": "ab54b542-25d7-4f29-a212-5943cafb05cc", "password": "TUIC_PASSWORD", "congestion_control": "bbr"},
    {"type": "hysteria2", "tag": "proxy-hysteria2", "server": "hysteria.secret.example", "server_port": 443, "password": "HYSTERIA2_PASSWORD", "obfs": {"type": "salamander", "password": "HYSTERIA2_OBFS_PASSWORD"}},
    {"type": "anytls", "tag": "proxy-anytls", "server": "anytls.secret.example", "server_port": 443, "password": "ANYTLS_PASSWORD"},
    {"type": "shadowtls", "tag": "proxy-shadowtls", "server": "shadowtls.secret.example", "server_port": 443, "password": "SHADOWTLS_PASSWORD"},
    {"type": "shadowsocks", "tag": "proxy-shadowsocks", "server": "ss.secret.example", "server_port": 8388, "method": "2022-blake3-aes-128-gcm", "password": "SHADOWSOCKS_PASSWORD"},
    {"type": "ssh", "tag": "proxy-ssh", "server": "ssh.secret.example", "server_port": 22, "user": "alice-ssh", "password": "SSH_PASSWORD", "private_key": ["SSH_PRIVATE_KEY_SECRET"], "private_key_path": "C:\\Users\\Alice\\.ssh\\id_ed25519", "private_key_passphrase": "SSH_KEY_PASSPHRASE", "host_key": ["SSH_HOST_PUBLIC_KEY"]},
    {"type": "naive", "tag": "proxy-naive", "server": "naive.secret.example", "server_port": 443, "username": "alice-naive", "password": "NAIVE_PASSWORD", "extra_headers": {"Proxy-Authorization": "Basic NAIVE_HEADER_SECRET", "Accept": "*/*"}},
    {"type": "snell", "tag": "proxy-snell", "server": "snell.secret.example", "server_port": 443, "psk": "SNELL_PSK_SECRET", "userkey": "SNELL_USER_KEY_SECRET"},
    {"type": "selector", "tag": "proxy-select", "outbounds": ["proxy-vless", "proxy-vmess"], "default": "proxy-vless"},
    {"type": "direct", "tag": "direct"},
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wg-home",
      "address": ["10.10.0.2/32", "fd00:10::2/128"],
      "private_key": "WIREGUARD_PRIVATE_KEY_SECRET",
      "peers": [{"address": "wg-peer.secret.example", "port": 51820, "public_key": "WIREGUARD_PUBLIC_KEY", "pre_shared_key": "WIREGUARD_PSK_SECRET", "allowed_ips": ["10.0.0.0/8", "fd00::/8"], "reserved": [1, 2, 3]}],
    },
    {
      "type": "tailscale",
      "tag": "ts-home",
      "state_directory": "C:\\Users\\Alice\\AppData\\Local\\tailscale",
      "auth_key": "TAILSCALE_AUTH_KEY_SECRET",
      "control_url": "https://control.private.example/",
      "hostname": "alice-router",
      "exit_node": "exit.private.example",
      "advertise_routes": ["192.168.0.0/16"],
      "relay_server_static_endpoints": ["172.16.10.20:3478"],
      "system_interface_name": "Tailscale Alice",
      "taildrop_directory": "C:\\Users\\Alice\\Downloads\\Taildrop",
    },
    {
      "type": "openconnect",
      "tag": "oc-work",
      "server": "vpn.corp.example",
      "username": "alice@corp.example",
      "password": "OPENCONNECT_PASSWORD",
      "cookie": "OPENCONNECT_SESSION_COOKIE",
      "local_hostname": "alice-laptop",
      "token": {"mode": "totp", "secret": "OPENCONNECT_TOTP_SECRET", "secret_path": "C:\\Users\\Alice\\totp.txt", "pin": "123456", "password": "OPENCONNECT_TOKEN_PASSWORD", "device_id": "openconnect-device-42"},
      "mobile": {"platform_version": "17", "device_type": "phone", "device_unique_id": "mobile-device-secret-id"},
      "csd": {"wrapper_path": "C:\\Users\\Alice\\csd.exe"},
      "tls": {"client_certificate": ["OPENCONNECT_CLIENT_CERTIFICATE"], "client_certificate_path": "C:\\Users\\Alice\\client.crt", "client_key": ["OPENCONNECT_CLIENT_KEY_SECRET"], "client_key_path": "C:\\Users\\Alice\\client.key", "client_key_password": "OPENCONNECT_CLIENT_KEY_PASSWORD", "mca_key": ["OPENCONNECT_MCA_KEY_SECRET"], "mca_key_path": "C:\\Users\\Alice\\mca.key", "mca_key_password": "OPENCONNECT_MCA_KEY_PASSWORD"},
      "forms": [{"submission_key": "OPENCONNECT_FORM_SUBMISSION_KEY", "name": "username", "value": "alice"}],
    },
    {
      "type": "openvpn",
      "tag": "ovpn-work",
      "servers": [{"server": "openvpn.corp.example", "server_port": 1194}],
      "address": ["10.8.0.2/24"],
      "username": "alice-openvpn",
      "password": "OPENVPN_PASSWORD",
      "static_key": ["OPENVPN_STATIC_KEY_SECRET"],
      "static_key_path": "C:\\Users\\Alice\\openvpn\\static.key",
      "tls": {"client_certificate": ["OPENVPN_CLIENT_CERTIFICATE"], "client_certificate_path": "C:\\Users\\Alice\\openvpn\\client.crt", "client_key": ["OPENVPN_CLIENT_KEY_SECRET"], "client_key_path": "C:\\Users\\Alice\\openvpn\\client.key", "client_key_password": "OPENVPN_CLIENT_KEY_PASSWORD", "peer_fingerprint": ["OPENVPN_PEER_FINGERPRINT"]},
    },
  ],
  "certificate_providers": [
    {
      "type": "acme",
      "tag": "acme-main",
      "domain": ["cert.private.example"],
      "data_directory": "C:\\Users\\Alice\\acme",
      "default_server_name": "cert.private.example",
      "email": "alice@example.org",
      "account_key": "ACME_ACCOUNT_PRIVATE_KEY",
      "external_account": {"key_id": "ACME_EXTERNAL_KEY_ID", "mac_key": "ACME_EXTERNAL_MAC_KEY"},
      "dns01_challenge": {"provider": "alidns", "access_key_id": "ALIBABA_ACCESS_KEY_ID", "access_key_secret": "ALIBABA_ACCESS_KEY_SECRET", "security_token": "ALIBABA_SECURITY_TOKEN"},
    },
    {
      "type": "acme",
      "tag": "acme-cloudflare",
      "dns01_challenge": {"provider": "cloudflare", "api_token": "CLOUDFLARE_API_TOKEN", "zone_token": "CLOUDFLARE_ZONE_TOKEN"},
    },
    {
      "type": "acme",
      "tag": "acme-dns",
      "dns01_challenge": {"provider": "acmedns", "username": "acmedns-alice", "password": "ACMEDNS_PASSWORD", "subdomain": "alice-acme-subdomain", "server_url": "https://alice:embedded-password@acme.private.example/register?token=ACMEDNS_QUERY_TOKEN"},
    },
    {
      "type": "cloudflare-origin-ca",
      "tag": "origin-ca",
      "domain": ["origin.private.example"],
      "data_directory": "C:\\Users\\Alice\\origin-ca",
      "api_token": "ORIGIN_CA_API_TOKEN",
      "origin_ca_key": "ORIGIN_CA_PRIVATE_KEY",
    },
  ],
  "services": [
    {"type": "api", "tag": "api", "listen": "127.0.0.1", "listen_port": 9090, "secret": "SING_BOX_API_SECRET"},
    {"type": "hysteria2-realm", "tag": "realm", "server_url": "https://realm.private.example/", "token": "HYSTERIA_REALM_TOKEN", "stun_servers": ["stun.private.example:3478"]},
    {"type": "ssm-api", "tag": "ssm", "servers": {"/": "shadowtls-in"}, "cache_path": "C:\\Users\\Alice\\ssm-cache.json"},
  ],
  "route": {
    "final": "proxy-select",
    "default_interface": "Ethernet 2",
    "dhcp_lease_files": ["C:\\ProgramData\\dhcp\\leases"],
    "rules": [
      {
        "domain": ["private.example.com", "corp.internal"],
        "domain_suffix": ["home.arpa"],
        "domain_regex": ["^secret\\.corp\\.example$"],
        "source_ip_cidr": ["192.168.1.0/24"],
        "ip_cidr": ["10.0.0.0/8"],
        "process_name": ["private-app.exe"],
        "process_path": ["C:\\Users\\Alice\\bin\\private-app.exe"],
        "process_path_regex": ["^C:\\\\Users\\\\Alice\\\\.*$"],
        "package_name": ["com.corp.secret"],
        "package_name_regex": ["^com\\.corp\\..*$"],
        "user": ["Alice"],
        "user_id": [1001],
        "wifi_ssid": ["Alice Home WiFi"],
        "wifi_bssid": ["aa:bb:cc:dd:ee:ff"],
        "source_mac_address": ["11:22:33:44:55:66"],
        "source_hostname": ["alice-laptop"],
        "interface_address": {"Ethernet 2": ["192.168.1.100/24"]},
        "outbound": "proxy-vless",
      },
      {"action": "resolve", "server": "dns-private"},
    ],
    "rule_set": [
      {"type": "local", "tag": "local-rules", "path": "C:\\Users\\Alice\\rules\\local.srs"},
      {"type": "remote", "tag": "remote-rules", "url": "https://rules.example/download.srs", "initial_path": "C:\\Users\\Alice\\rules\\remote.srs"},
    ],
  },
  "experimental": {
    "cache_file": {"enabled": true, "path": "C:\\Users\\Alice\\AppData\\Local\\sing-box\\cache.db"},
    "clash_api": {"external_ui": "C:\\Users\\Alice\\dashboard", "external_ui_download_url": "https://ui.example/archive.zip", "secret": "CLASH_API_SECRET"},
  },
  "custom_url": "https://alice:secret@example.com/api?token=URL_QUERY_TOKEN&keep=yes",
  "custom_jwt": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhbGljZSJ9.jwtSignatureSecret",
  "custom_material": "-----BEGIN OPENSSH PRIVATE KEY-----\nGENERIC_PEM_PRIVATE_KEY_SECRET\n-----END OPENSSH PRIVATE KEY-----",
}
